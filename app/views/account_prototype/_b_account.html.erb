<main class="page">
  <header class="game-header"><h1><a href="?<%= request.query_parameters.merge(page: "home").to_query %>">CatDog</a></h1><a href="#">Sign out</a></header>
  <h2 class="proto-h2"><%= @name %></h2>
  <nav class="proto-tabs"><a href="#games">Games</a><a href="#stats">Statistics</a><a href="#name">Name</a><a href="#settings">Settings</a><a href="#passkeys">Passkeys</a></nav>
  <section class="card" id="games"><h2>Your games</h2><%= render "games_list" %><a class="button primary">New game</a></section>
  <section class="card" id="stats"><h2>Statistics</h2>
    <p><strong><%= @stats[:played] %></strong> games · won <%= @stats[:won] %> · draw <%= @stats[:drawn] %> · lost <%= @stats[:lost] %></p>
    <a href="/prototype/stats">Your statistics →</a></section>
  <section class="card" id="name"><h2>Display name</h2><%= render "name_form" %></section>
  <section class="card" id="settings"><h2>Settings</h2>
    <div class="settings" style="display:flex;flex-wrap:wrap;gap:8px 12px">
      <label>Art style <select><option>Fur</option></select></label>
      <label>Cat colour <select><option>Orange</option></select></label>
      <label>Dog colour <select><option>Blue</option></select></label>
      <label class="check"><input type="checkbox"> Auto-draw</label>
    </div>
    <small class="proto-muted">Saved to your account. Also on every game page.</small></section>
  <section class="card" id="passkeys"><h2>Passkeys</h2><%= render "passkeys" %></section>
  <%= render "danger" %>
</main>
