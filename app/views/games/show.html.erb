<% content_for :title, page_title(@engine, @me, hot_seat: @game.hot_seat?) %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>

<% opponent_seat = @game.seats.find { it.position == Rules.opponent(@seat.position) } %>
<main class="page game" data-controller="resync presence" data-action="presence:disconnected->resync#connectionLost presence:connected->resync#connectionBack" data-presence-game-value="<%= @game.public_id %>" data-presence-opponent-value="<%= Rules.opponent(@seat.position) %>" data-presence-seen-ago-value="<%= opponent_seat&.seen_ago || -1 %>">
  <%= turbo_stream_from @game %>
  <header class="game-header">
    <h1>CatDog</h1>
    <%= render "settings" %>
  </header>
  <% if flash[:alert] %><p class="alert"><%= flash[:alert] %></p><% end %>

  <div class="sticky">
    <p class="banner" id="reconnecting" data-resync-target="banner" data-turbo-permanent hidden>Reconnecting…</p>
    <p id="status" class="<%= class_names(turn_bar_class(@engine, @me, hot_seat: @game.hot_seat?)) %>" data-controller="turn-cue" data-turn-cue-alert-value="<%= turn_alert(@engine, @me, hot_seat: @game.hot_seat?) %>" data-turn-cue-ended-value="<%= @game.ended? %>"><%= @engine ? status_line(@engine, @me, hot_seat: @game.hot_seat?) : "Waiting for your opponent." %><% if rematch_offered_to?(@game, @seat) %> <a class="offer" id="offer-cue" href="#result">Opponent offers a rematch ↑</a><% end %></p>
  </div>

  <% if @game.ended? %>
    <%= render "result", game: @game, engine: @engine, me: @me, seat: @seat, hot_seat: @game.hot_seat? %>
  <% end %>

  <% if @game.lobby? %>
    <%= render "copy_field", id: "invite-link", label: "Invite link", value: game_url(@game) %>
    <div class="row">
      <span>Or play both seats on this screen:</span>
      <%= button_to "Play here instead", game_hot_seat_path(@game), id: "play-here", class: "button" %>
    </div>
  <% else %>
    <%= render "table", game: @game, engine: @engine, me: @me, hot_seat: @game.hot_seat?, opponent_online: opponent_seat&.online? %>
  <% end %>

  <% if @game.playing? %>
    <%= button_to "Resign", game_moves_path(@game), params: { kind: "resign", seq: @game.state_seq }, id: "resign", class: "button danger", form: { data: { turbo_confirm: @game.hot_seat? ? "Resign for Player #{@me}? Player #{Rules.opponent(@me)} wins at once." : "Resign this game? Your opponent wins at once." } } %>
  <% end %>

  <details class="seat-link">
    <summary>Open on another device</summary>
    <%= render "copy_field", id: "seat-link", label: "Seat link (keep it private)", value: game_seat_link_url(@game, token: seat_token_for(@game)) %>
  </details>
</main>
